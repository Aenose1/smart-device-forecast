# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# There is no user login. Visitors use the site directly; only /api/admin/* needs ADMIN_API_KEY.

# --- Database ---
# LOCAL RUN (default): a single-file SQLite database, nothing to install.
DATABASE_URL=sqlite:///./dev.db
# PRODUCTION on Render: use a PostgreSQL URL (Render's own or an external one such as Neon). Render's disk is wiped on every
# redeploy/restart, so SQLite there loses all data. postgres:// and postgresql:// URLs are accepted as-is.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Docker only: docker-compose builds DATABASE_URL from these three values.
POSTGRES_USER=sdf_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sdf

# --- Administration (dataset upload, model training, device editing, logs) ---
# Long random value, at least 16 characters. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to switch administration OFF. The admin pages ask for this key; it never goes into the frontend build.
ADMIN_API_KEY=
# DEMO ONLY: true = admin pages open without a key. Honoured on a local computer only; ignored when ENVIRONMENT=production
# or when running on Render. Keep false anywhere the site is public.
ALLOW_OPEN_ADMIN=false

# --- Web ---
# Allowed browser origins. The default already contains https://smart-device-forcast-1.vercel.app and the local dev servers;
# set this only to replace the list (comma-separated, no trailing slash, never "*").
# CORS_ORIGINS=https://smart-device-forcast-1.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# Optional, for Vercel preview URLs. Must be anchored. Example (replace myteam with your Vercel team slug):
# CORS_ORIGIN_REGEX=^https://smart-device-forcast-1-[a-z0-9]+-myteam\.vercel\.app$
ENVIRONMENT=development       # set to production on a public server (Render is also detected automatically)
TRUST_PROXY=false             # set true on Render so rate limits use each visitor's real IP
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true

# --- Forecasting ---
MAX_FORECAST_YEARS=5
DEFAULT_FORECAST_YEARS=3
MODELS_DIR=models

# --- Sample data ---
SEED_SAMPLE_DATA=true         # loads the clearly-labelled synthetic DEMO catalogue/prices; safe to repeat. Set false for real data only.
